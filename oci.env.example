# Copy to oci.env (or run: python setup_wizard.py). Quote values that contain spaces.

# --- OCI account ---
OCI_CONFIG="C:/path/to/oci-out-of-host-capacity-fix/oci_config"
# Suffix of the availability domain(s), comma separated: AD-1 or AD-1,AD-2,AD-3
OCT_FREE_AD="AD-1"
DISPLAY_NAME="free-instance"

# --- What to launch (the launcher refuses anything outside Always Free) ---
# VM.Standard.A1.Flex (ARM, 4 OCPU / 24 GB free in total) or VM.Standard.E2.1.Micro (AMD, 2 free)
OCI_COMPUTE_SHAPE="VM.Standard.A1.Flex"
# 2/12 is easier to get; grow it later with: python main.py resize
OCPUS="2"
MEMORY_GB="12"
RESIZE_OCPUS="4"
RESIZE_MEMORY_GB="24"
SECOND_MICRO_INSTANCE="False"
REQUEST_WAIT_TIME_SECS="60"
SSH_AUTHORIZED_KEYS_FILE="C:/path/to/oci-out-of-host-capacity-fix/ssh_key.pub"

# --- Network: empty OCI_SUBNET_ID = use an existing public subnet, or create one (free) ---
OCI_SUBNET_ID=""
CREATE_NETWORK="True"
ASSIGN_PUBLIC_IP="True"

# --- Image: OCI_IMAGE_ID wins over OPERATING_SYSTEM / OS_VERSION ---
OCI_IMAGE_ID=""
OPERATING_SYSTEM="Canonical Ubuntu"
OS_VERSION="22.04"
# Boot volume in GB (50 minimum; all volumes together must stay within 200 GB)
BOOT_VOLUME_SIZE="50"

# --- Notifications ---
DESKTOP_NOTIFY="True"
NOTIFY_EMAIL="False"
EMAIL=""
EMAIL_PASSWORD=""
DISCORD_WEBHOOK=""
TELEGRAM_TOKEN=""
TELEGRAM_USER_ID=""
